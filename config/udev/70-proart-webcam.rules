# SPDX-License-Identifier: GPL-2.0-only
# ASUS FHD webcam (636e:0bdb) on the ProArt P16: anti-flicker filter for 50 Hz mains (Europe and others).
# The camera defaults to 60 Hz, which causes banding under artificial light on 50 Hz mains.
# Only the RGB camera (not the IR camera) is matched.
ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="636e", ATTRS{idProduct}=="0bdb", ATTR{name}=="*FHD webca", ATTR{index}=="0", RUN+="/usr/bin/v4l2-ctl -d $devnode -c power_line_frequency=1"
