# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Phone calls through a paired phone in GNOME Calls (bridge to PipeWire telephony)
After=pipewire.service wireplumber.service

[Service]
ExecStart=%h/.local/bin/proart-phone-bridge
Environment=PYTHONWARNINGS=ignore::DeprecationWarning
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
