[Unit]
Description=ASUS ProArt P16: enable the tweeters and mute them while headphones are plugged in
# sound.target: the card must exist, otherwise the first starts fail ("Invalid card number")
After=pipewire.service wireplumber.service sound.target
Wants=wireplumber.service

[Service]
ExecStart=%h/.local/bin/proart-tweeter
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
