#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
# Tone control for the ASUS ProArt P16 speakers: change it live and save it permanently.
#   proart-eq                                  show the current settings
#   proart-eq <bass> <mid> <presence> <treble> set all four (dB), e.g.  proart-eq 2 3 3 1
#   proart-eq bass=4 treble=2                  change single bands
import json
import pathlib
import re
import subprocess
import sys

CONF = pathlib.Path.home() / ".config/pipewire/pipewire.conf.d/60-proart-2way.conf"
SINK = "proart_speakers"
BANDS = {"bass": ("bassL", "bassR"), "mid": ("midL", "midR"),
         "presence": ("presL", "presR"), "treble": ("shL", "shR")}
ALIASES = {"mids": "mid", "middle": "mid", "highs": "treble", "high": "treble"}
GAIN = r'(name = %s\s+label = \S+\s+control = \{[^}]*"Gain" = )([-\d.]+)'

text = CONF.read_text()


def gain_of(node):
    return float(re.search(GAIN % node, text).group(2))


args = sys.argv[1:]
new = {}
if len(args) == 4 and all("=" not in a for a in args):
    new = dict(zip(BANDS, map(float, args)))
else:
    for arg in args:
        if "=" not in arg:
            sys.exit(f"usage: proart-eq [bass=<dB>] [mid=<dB>] [presence=<dB>] [treble=<dB>]")
        band, value = arg.split("=", 1)
        band = ALIASES.get(band.lower(), band.lower())
        if band not in BANDS:
            sys.exit(f"unknown band: {band} (bass, mid, presence, treble)")
        new[band] = float(value)

for band, gain in new.items():
    if not -12 <= gain <= 12:
        sys.exit(f"{band}: {gain} dB is outside -12..+12")
    for node in BANDS[band]:
        text = re.sub(GAIN % node, r"\g<1>%.1f" % gain, text)

if new:
    CONF.write_text(text)
    dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True).stdout)
    node_id = next((o["id"] for o in dump if o.get("type", "").endswith("Node")
                    and o.get("info", {}).get("props", {}).get("node.name") == SINK), None)
    if node_id is not None:
        params = " ".join(f'"{n}:Gain" {g:.1f}' for b, g in new.items() for n in BANDS[b])
        subprocess.run(["pw-cli", "s", str(node_id), "Props", f"{{ params = [ {params} ] }}"],
                       capture_output=True)

for band, (node, _) in BANDS.items():
    print(f"{band:9} {gain_of(node):+5.1f} dB")
