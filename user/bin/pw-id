#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
# Print the PipeWire object id of a node.name.  Usage: pw-id <node.name>
import json, subprocess, sys
for o in json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True).stdout):
    if o.get("type", "").endswith("Node") and o.get("info", {}).get("props", {}).get("node.name") == sys.argv[1]:
        print(o["id"]); break
