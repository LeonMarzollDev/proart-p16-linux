#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
# ASUS ProArt P16: show the keyboard's Fn-lock state (F1-F12 or media keys first).
# Reads the fn_lock attribute of the patched hid-asus driver (patch 0006), shows a top-bar
# indicator (needs gir1.2-ayatanaappindicator3-0.1 and GNOME's AppIndicator extension) and a
# notification whenever Fn+Esc changes it.
import glob
import os

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Notify", "0.7")
from gi.repository import GLib, Gtk, Notify  # noqa: E402

try:
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
except (ValueError, ImportError):
    AppIndicator = None

ATTR_GLOB = "/sys/bus/hid/devices/*0B05:4B42*/fn_lock"
ICON = "input-keyboard-symbolic"
TEXT = {
    "1": ("F1–F12", "Fn-Lock: F1–F12 keys first", "Press Fn for the media keys. Fn+Esc switches."),
    "0": ("Media", "Fn-Lock: media keys first", "Press Fn for F1–F12. Fn+Esc switches."),
}


class FnLockIndicator:
    def __init__(self):
        Notify.init("ProArt Fn-Lock")
        self.note = Notify.Notification.new("", "", ICON)
        self.note.set_hint("transient", GLib.Variant.new_boolean(True))
        self.fd = None
        self.watch = None
        self.state = None
        self.indicator = None
        if AppIndicator:
            self.indicator = AppIndicator.Indicator.new(
                "proart-fnlock", ICON, AppIndicator.IndicatorCategory.HARDWARE)
            self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
            menu = Gtk.Menu()
            self.menu_state = Gtk.MenuItem(label="Fn-Lock: unknown")
            self.menu_state.set_sensitive(False)
            menu.append(self.menu_state)
            menu.append(Gtk.MenuItem(label="Fn+Esc switches the F-row"))
            menu.get_children()[-1].set_sensitive(False)
            menu.show_all()
            self.indicator.set_menu(menu)
        self.open_attr()
        # fallback: re-open after a driver reload and catch missed changes
        GLib.timeout_add_seconds(3, self.check)

    def open_attr(self):
        if self.fd is not None:
            return True
        paths = glob.glob(ATTR_GLOB)
        if not paths:
            return False
        self.fd = os.open(paths[0], os.O_RDONLY)
        # sysfs_notify() wakes poll() with POLLPRI/POLLERR
        self.watch = GLib.io_add_watch(self.fd, GLib.PRIORITY_DEFAULT,
                                       GLib.IO_PRI | GLib.IO_ERR, self.on_change)
        self.read(notify=False)
        return True

    def close_attr(self):
        if self.watch:
            GLib.source_remove(self.watch)
        if self.fd is not None:
            os.close(self.fd)
        self.fd = self.watch = None

    def read(self, notify=True):
        try:
            os.lseek(self.fd, 0, os.SEEK_SET)
            value = os.read(self.fd, 8).decode().strip()
        except OSError:
            self.close_attr()
            return
        if value not in TEXT or value == self.state:
            return
        first = self.state is None
        self.state = value
        label, title, body = TEXT[value]
        if self.indicator:
            self.indicator.set_label(label, "F1–F12")
            self.indicator.set_title(title)
            self.menu_state.set_label(title)
        if notify and not first:
            self.note.update(title, body, ICON)
            try:
                self.note.show()
            except GLib.Error:
                pass

    def on_change(self, *_):
        self.read()
        return True

    def check(self):
        if self.open_attr():
            self.read()
        return True


if __name__ == "__main__":
    FnLockIndicator()
    Gtk.main()
