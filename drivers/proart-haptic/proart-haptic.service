# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Haptic click feedback for the ASUS ProArt P16 touchpad

[Service]
ExecStart=/usr/local/bin/proart-haptic
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
